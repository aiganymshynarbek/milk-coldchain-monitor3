{
  "name": "coldchain-monitor (Docker + Jenkins in the cloud)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "Jenkins", "onAutoForward": "notify" },
    "8000": { "label": "coldchain API (staging)", "onAutoForward": "notify" }
  },
  "containerEnv": { "REPO_URL": "https://github.com/${localEnv:GITHUB_REPOSITORY}.git" },
  "postCreateCommand": "pip install --user -e '.[dev]'"
}
